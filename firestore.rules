rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Site text, media slots and settings: everyone reads, only Carson (and
    // Laakea) write.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /slides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /films/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Added by hand in the Firebase console. A signed-in user may check only
    // their own entry; nobody can write one from the browser.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
